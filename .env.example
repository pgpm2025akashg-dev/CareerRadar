# AI-powered JD explanation (optional but recommended)
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# Apify job discovery (recommended for Google Jobs + public LinkedIn job results)
# Create an Apify account, copy your API token from Settings > API & Integrations,
# and keep it private. Do not use LinkedIn passwords or cookies.
APIFY_API_TOKEN=
# Optional overrides; defaults are the documented actors below.
APIFY_GOOGLE_ACTOR_ID=googleapi/google-jobs-search-scraper
APIFY_LINKEDIN_ACTOR_ID=data_forge_org/linkedin-scraper

# Optional Adzuna API source. Create credentials through the Adzuna developer portal.
ADZUNA_APP_ID=
ADZUNA_APP_KEY=

# Optional comma-separated RSS feed URLs from sources you are permitted to use.
JOB_RSS_FEEDS=
